#: pretix_sideburn_lottery/apps.py
msgid "Sideburn Lottery"
msgstr "Loterie Sideburn"

#: pretix_sideburn_lottery/apps.py
msgid "Waiting-list lottery mechanics for Sideburn events"
msgstr ""
"Mécanique de loterie de la liste d'attente pour les événements Sideburn"

#: pretix_sideburn_lottery/forms.py pretix_sideburn_lottery/models.py
msgid "Lottery group"
msgstr "Groupe de loterie"

#: pretix_sideburn_lottery/forms.py
msgid "Register on my own"
msgstr "M'inscrire individuellement"

#: pretix_sideburn_lottery/forms.py
msgid "Create a new group"
msgstr "Créer un nouveau groupe"

#: pretix_sideburn_lottery/forms.py
msgid "Join an existing group"
msgstr "Rejoindre un groupe existant"

#: pretix_sideburn_lottery/forms.py
#, python-format
msgid ""
"Optional. Joining a group doesn't change your odds in the lottery: your "
"group is one entry, same as someone registering on their own. When tickets "
"are offered, your group needs one ticket per person and moves together. "
"Groups can have up to %(max)s people."
msgstr ""
"Facultatif. Rejoindre un groupe ne change pas vos chances à la loterie : "
"votre groupe compte comme une seule inscription, comme une personne qui "
"s'inscrit individuellement. Lorsque des billets sont proposés, votre groupe "
"a besoin d'un billet par personne et avance ensemble. Un groupe peut compter "
"jusqu'à %(max)s personnes."

#: pretix_sideburn_lottery/forms.py pretix_sideburn_lottery/models.py
msgid "Group code"
msgstr "Code du groupe"

#: pretix_sideburn_lottery/forms.py
msgid "Ask the person who created the group for its code."
msgstr "Demandez le code à la personne qui a créé le groupe."

#: pretix_sideburn_lottery/forms.py
msgid "Enter the code of the group you want to join."
msgstr "Saisissez le code du groupe que vous voulez rejoindre."

#: pretix_sideburn_lottery/forms.py
#, python-format
msgid ""
"Your group code is %(code)s. Share it with your friends so they can join "
"your group."
msgstr ""
"Le code de votre groupe est %(code)s. Partagez-le avec vos amis pour qu'ils "
"puissent rejoindre votre groupe."

#: pretix_sideburn_lottery/forms.py
#, python-format
msgid "You've joined group %(code)s."
msgstr "Vous avez rejoint le groupe %(code)s."

#: pretix_sideburn_lottery/forms.py
#, python-format
msgid ""
"You're on the waiting list, but we couldn't add you to the group: %(reason)s"
msgstr ""
"Vous êtes sur la liste d'attente, mais nous n'avons pas pu vous ajouter au "
"groupe : %(reason)s"

#: pretix_sideburn_lottery/forms.py
msgid "Lottery"
msgstr "Loterie"

#: pretix_sideburn_lottery/forms.py
msgid "Allow registrants to line up together"
msgstr "Permettre aux inscrits de faire la file ensemble"

#: pretix_sideburn_lottery/forms.py
msgid ""
"Registrants for this product can create or join a group when they sign up "
"for the waiting list. A group enters the lottery as one entry, so its "
"members are offered tickets together. Being in a group does not improve "
"chances of getting a ticket."
msgstr ""
"Les inscrits pour ce produit peuvent créer ou rejoindre un groupe lors de "
"leur inscription sur la liste d'attente. Un groupe participe à la loterie "
"comme une seule inscription, ses membres se voient donc proposer des billets "
"ensemble. Faire partie d'un groupe n'augmente pas les chances d'obtenir un "
"billet."

#: pretix_sideburn_lottery/models.py
msgid "Created"
msgstr "Date de création"

#: pretix_sideburn_lottery/models.py
msgid "Lottery groups"
msgstr "Groupes de loterie"

#: pretix_sideburn_lottery/models.py
msgid "Waiting list entry"
msgstr "Inscription sur la liste d'attente"

#: pretix_sideburn_lottery/models.py
msgid "Joined"
msgstr "Date d'adhésion"

#: pretix_sideburn_lottery/models.py
msgid "Lottery group membership"
msgstr "Appartenance à un groupe de loterie"

#: pretix_sideburn_lottery/models.py
msgid "Lottery group memberships"
msgstr "Appartenances à un groupe de loterie"

#: pretix_sideburn_lottery/services/groups.py
msgid "Groups aren't available for this product."
msgstr "Les groupes ne sont pas disponibles pour ce produit."

#: pretix_sideburn_lottery/services/groups.py
msgid ""
"The lottery for this product has already taken place, so groups can no "
"longer be changed."
msgstr ""
"La loterie pour ce produit a déjà eu lieu, les groupes ne peuvent donc plus "
"être modifiés."

#: pretix_sideburn_lottery/services/groups.py
msgid "We couldn't find a group with that code."
msgstr "Nous n'avons trouvé aucun groupe avec ce code."

#: pretix_sideburn_lottery/services/groups.py
msgid "That group is for a different product."
msgstr "Ce groupe correspond à un autre produit."

#: pretix_sideburn_lottery/services/groups.py
msgid "That group is already full."
msgstr "Ce groupe est déjà complet."

#: pretix_sideburn_lottery/services/lottery.py
msgid "Name"
msgstr "Nom"

#: pretix_sideburn_lottery/services/lottery.py
msgid "E-mail address"
msgstr "Adresse e-mail"

#: pretix_sideburn_lottery/services/lottery.py
msgid "Phone number"
msgstr "Numéro de téléphone"

#: pretix_sideburn_lottery/models.py
#: pretix_sideburn_lottery/services/lottery.py
#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_rank.html
msgid "Product"
msgstr "Produit"

#: pretix_sideburn_lottery/services/lottery.py
msgid "On list since"
msgstr "Sur la liste depuis"

#: pretix_sideburn_lottery/services/lottery.py
#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_rank.html
msgid "Status"
msgstr "Statut"

#: pretix_sideburn_lottery/services/lottery.py
msgid "Voucher code"
msgstr "Code du bon d'achat"

#: pretix_sideburn_lottery/services/lottery.py
msgid "Language"
msgstr "Langue"

#: pretix_sideburn_lottery/services/lottery.py
msgid "Priority"
msgstr "Priorité"

#: pretix_sideburn_lottery/services/lottery.py
msgid "Voucher redeemed"
msgstr "Bon d'achat utilisé"

#: pretix_sideburn_lottery/services/lottery.py
msgid "Voucher expired"
msgstr "Bon périmé"

#: pretix_sideburn_lottery/services/lottery.py
msgid "Voucher assigned"
msgstr "Bon attribué"

#: pretix_sideburn_lottery/services/lottery.py
msgid "Waiting"
msgstr "En attente"

#: pretix_sideburn_lottery/services/presale.py
#, python-format
msgid "Ticket lottery held on %(date)s"
msgstr "Loterie des billets tenue le %(date)s"

#: pretix_sideburn_lottery/services/presale.py
msgid "These tickets will be assigned by lottery"
msgstr "Ces billets seront attribués par tirage au sort"

#: pretix_sideburn_lottery/services/waitinglist.py
#, python-brace-format
msgid ""
"Hello,\n"
"\n"
"This is to confirm that you have been added to the lottery for {event}.\n"
"\n"
"Once the ticket lottery has taken place, those selected will receive an email with a voucher to purchase a ticket.\n"
"\n"
"If you are not selected in the initial lottery, you will be added to a waiting list\n"
"and will receive an email when a ticket is available for you.\n"
"\n"
"Want to stay in the loop about the latest news about SideBurn? Subscribe to our newsletter here: http://eepurl.com/ij4Off\n"
"\n"
"Best regards,\n"
"Your {event} ticketing team"
msgstr ""
"Bonjour,\n"
"\n"
"Nous vous confirmons votre inscription à la loterie pour {event}.\n"
"\n"
"Une fois la loterie des billets effectuée, les personnes sélectionnées recevront un e-mail avec un bon d'achat pour acheter un billet.\n"
"\n"
"Si votre inscription n'est pas retenue lors de la loterie initiale, elle sera ajoutée à une liste d'attente\n"
"et vous recevrez un e-mail lorsqu'un billet sera disponible pour vous.\n"
"\n"
"Vous voulez suivre les dernières nouvelles de SideBurn ? Abonnez-vous à notre infolettre ici : http://eepurl.com/ij4Off\n"
"\n"
"Cordialement,\n"
"L'équipe billetterie de {event}"

#: pretix_sideburn_lottery/services/waitinglist.py
#, python-brace-format
msgid "You have been added to the lottery waiting list for {event}"
msgstr "Inscription confirmée à la liste d'attente de la loterie pour {event}"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/checkout_waiver.html
msgid "Before you proceed, please read the following documents:"
msgstr "Avant de continuer, veuillez lire les documents suivants :"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/checkout_waiver.html
msgid "Release of Waiver and Liability"
msgstr "Décharge et renonciation à la responsabilité"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/checkout_waiver.html
msgid "SideBurn Code of Conduct"
msgstr "Code de conduite SideBurn"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/checkout_waiver.html
msgid ""
"For each document, enter the confirmation words in the form below to show you"
" agree."
msgstr ""
"Pour chaque document, saisissez les mots de confirmation dans le formulaire "
"ci-dessous pour montrer que vous êtes d'accord."

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/sold_out_availability.html
msgid "Register here"
msgstr "Inscrivez-vous ici"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_lottery_actions.html
msgid "Run lottery"
msgstr "Lancer la loterie"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_lottery_actions.html
msgid "Revert list"
msgstr "Rétablir la liste"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_lottery_actions.html
msgid "Close"
msgstr "Fermer"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_lottery_actions.html
msgid "Confirm Lottery Run"
msgstr "Confirmer le lancement de la loterie"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_lottery_actions.html
msgid "Warning!"
msgstr "Attention !"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_lottery_actions.html
msgid "Are you sure you want to proceed?"
msgstr "Voulez-vous vraiment continuer ?"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_lottery_actions.html
msgid "Cancel"
msgstr "Annuler"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_lottery_actions.html
msgid "Yes, run the lottery"
msgstr "Oui, lancer la loterie"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_rank.html
msgid "Check my spot in line"
msgstr "Vérifier ma place dans la file"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_rank.html
#, python-format
msgid ""
"Your voucher expired on %(day)s at %(time)s. Please feel free to re-enter the"
" waiting list."
msgstr ""
"Votre bon d'achat a expiré le %(day)s à %(time)s. N'hésitez pas à vous "
"réinscrire sur la liste d'attente."

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_rank.html
msgid ""
"You have a voucher waiting for redemption! Check your email for details."
msgstr ""
"Un bon d'achat vous attend ! Consultez vos e-mails pour plus de détails."

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_rank.html
msgid ""
"You are on the waiting list for this event. The lottery hasn't yet been run."
msgstr ""
"Vous êtes sur la liste d'attente de cet événement. La loterie n'a pas encore "
"eu lieu."

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_rank.html
#, python-format
msgid "You are %(ordinal)s in line"
msgstr "Vous êtes %(ordinal)s dans la file"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_rank.html
msgid "Unable to determine rank."
msgstr "Impossible de déterminer votre rang."

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/fragment/waitinglist_rank.html
msgid "You are not on the waiting list for this event."
msgstr "Vous n'êtes pas sur la liste d'attente de cet événement."

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/waitinglist.html
msgid "Waiting list"
msgstr "Liste d'attente"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/waitinglist.html
msgid "How do tickets work for SideBurn?"
msgstr "Comment fonctionnent les billets pour SideBurn ?"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/waitinglist.html
msgid ""
"Since demand for SideBurn tickets outnumbers supply, <strong>the first stage "
"of getting a ticket is registering for the ticket lottery</strong>."
msgstr ""
"Étant donné que la demande de billets SideBurn dépasse l'offre, <strong>la "
"première étape pour obtenir un billet consiste à s'inscrire à la loterie de "
"billets</strong>."

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/waitinglist.html
msgid ""
"The registrations for the general sale are drawn in a lottery, ensuring that "
"everyone registered has an equal chance of being offered a ticket."
msgstr ""
"Les inscriptions à la vente générale sont mélangées dans une loterie "
"garantissant que chaque inscrit a une chance égale de se voir offrir un "
"billet."

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/waitinglist.html
msgid ""
"Available tickets are then offered in the order of the lottery, and "
"registrants have three days to buy their available ticket before it’s added "
"back to the pool and offered to the next in the list."
msgstr ""
"Les billets disponibles sont ensuite proposés dans l'ordre de la loterie, et "
"les inscrits ont trois jours pour acheter leur billet disponible avant qu'il "
"ne soit rajouté au groupe et offert au suivant dans la liste."

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/waitinglist.html
msgid ""
"If you register for a ticket after sales are already in progress, you simply "
"get added to the bottom of the list."
msgstr ""
"Si vous vous inscrivez pour un billet alors que les ventes sont déjà en "
"cours, vous êtes simplement ajouté au bas de la liste."

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/waitinglist.html
msgid "Register only once per person"
msgstr "Inscrivez-vous une seule fois par personne"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/waitinglist.html
msgid ""
"Registering again with another email - or trying again with the same one - "
"could disqualify you from the ticketing lottery!"
msgstr ""
"Vous inscrire à nouveau avec une autre adresse e-mail - ou réessayer avec la "
"même - pourrait vous disqualifier de la loterie de billetterie !"

#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/waitinglist.html
msgid "Add me to the list"
msgstr "Ajoutez-moi à la liste"

#: pretix_sideburn_lottery/models.py
#: pretix_sideburn_lottery/templates/pretix_sideburn_lottery/waitinglist.html
msgid "Event"
msgstr "Événement"

#: pretix_sideburn_lottery/views/control.py
msgid "You must select a product to run or revert its lottery."
msgstr ""
"Vous devez sélectionner un produit pour lancer sa loterie ou rétablir sa "
"liste."

#: pretix_sideburn_lottery/views/control.py
msgid "Invalid product selected."
msgstr "Produit non valide sélectionné."

#: pretix_sideburn_lottery/views/control.py
msgid "No waiting list entries found for the selected product."
msgstr ""
"Aucune inscription sur la liste d'attente n'a été trouvée pour le produit "
"sélectionné."
